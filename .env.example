# Local development values only. Never commit your real credentials.
POSTGRES_DB=milo
POSTGRES_USER=milo
POSTGRES_PASSWORD=milo_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://milo:milo_local@127.0.0.1:5432/milo

MASTRA_SCHEMA=mastra
AGENT_HOST=127.0.0.1
AGENT_PORT=4111
PORT=3000

# No model key or MCP credentials are required for the foundation.
# Compose supplies the internal database hostname to the Agent container.
