{
  "name": "@milo/agent-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts --format esm --platform node --sourcemap --clean",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@milo/agent": "workspace:*",
    "@milo/domain": "workspace:*",
    "zod": "4.6.7"
  }
}
